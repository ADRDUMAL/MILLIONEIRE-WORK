{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cardapio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cardapio-3d-ar",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "cardapio-safe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cardapio-3d-ar",
        "run",
        "dev:safe"
      ],
      "port": 3001
    },
    {
      "name": "cardapio-safe-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cardapio-3d-ar",
        "run",
        "dev:safe:http"
      ],
      "port": 3001
    }
  ]
}
